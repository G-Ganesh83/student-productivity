PORT=8000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/learn_easy?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# Sandboxed code execution
CODE_RUNNER_URL=https://emkc.org/api/v2/piston/execute
# ALLOW_INVALID_CERTS=false  # Set to true ONLY in local dev with a TLS-intercepting proxy (e.g. Charles, mitmproxy). Never enable in production.

# PYTHON_SANDBOX_VERSION=3.10.0
# CODE_TIMEOUT_MS=10000

